# ---------------------------------------------------------------------------
# Copy to .env before running locally:  cp .env.example .env
#
# Every value here maps 1:1 to a field on Settings in app/core/config.py.
# There is exactly ONE place that reads the environment (that class), so this
# file is the complete, authoritative list of knobs. Nothing in the codebase
# calls os.getenv() directly — see app/core/README.md for why.
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
DEBUG=true                       # forced off when ENVIRONMENT=production
APP_NAME=Food Waste App
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                   # false = pretty console logs; true = JSON for log shippers

# --- Security -------------------------------------------------------------
# Generate a real one with:  openssl rand -hex 32
# The app REFUSES TO START in production if this is left at the sample value.
SECRET_KEY=change-me-in-production-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15    # short — a leaked access token dies fast
REFRESH_TOKEN_EXPIRE_DAYS=7       # long — but rotated on every use
BCRYPT_ROUNDS=12                  # 12 ≈ 250ms/hash. Lower ONLY in tests.

# Explicit allowlist. Never "*" together with credentials.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Trusted Host protection (blocks Host-header attacks). "*" only in dev.
ALLOWED_HOSTS=["*"]

# --- Database -------------------------------------------------------------
# Single async URL — Alembic reuses it (see docs/adr/0003-async-alembic-single-driver.md).
# Host is "postgres" inside docker compose, "localhost" when running on the host.
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/foodwaste
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_PRE_PING=true             # detects connections killed by the DB/proxy
DB_ECHO=false                     # true = log every SQL statement (noisy, dev only)

# Consumed by the postgres container itself in docker-compose.yml.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=foodwaste

# --- Redis ----------------------------------------------------------------
# One Redis instance, three logical uses (separate key prefixes, not separate DBs):
#   rl:*        slowapi rate-limit counters
#   cache:*     cache-aside read cache
#   denylist:*  revoked JWT ids
REDIS_URL=redis://redis:6379/0
CACHE_DEFAULT_TTL_SECONDS=60

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=200/minute     # applies to every route unless overridden
RATE_LIMIT_LOGIN=5/minute         # brute-force protection
RATE_LIMIT_REGISTER=3/hour        # signup-spam protection
RATE_LIMIT_WRITE=30/minute        # POST/PATCH/DELETE

# --- Seed data (migration 0002) -------------------------------------------
# NOTE THE DOMAIN. It must be one `EmailStr` accepts, because the seeded admin has
# to be able to log in through the same validated endpoint as everyone else.
# email-validator rejects special-use TLDs (.local, .test, .invalid, .localhost), so
# `admin@foodwaste.local` creates a row that can NEVER authenticate — a 422 from the
# login endpoint's own validation. `.example` is reserved for documentation and is
# accepted. (Found by logging in as the seeded admin against the running stack.)
SEED_ADMIN_EMAIL=admin@foodwaste.example
SEED_ADMIN_PASSWORD=ChangeMe123!
